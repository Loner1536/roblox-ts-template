{
    "name": "roblox-ts-template",
    "emitLegacyScripts": false,
    "globIgnorePaths": ["**/package.json", "**/tsconfig.json"],
    "tree": {
        "$className": "DataModel",
        "Workspace": { "$properties": { "LuauTypeCheckMode": "Strict", "UseNewLuauTypeSolver": "Enabled" } },
        "ReplicatedStorage": {
            "Client": { "$path": "out/client" },
            "Shared": { "$path": "out/shared" },
            "rbxts_include": {
                "$path": "include",
                "node_modules": { "$className": "Folder", "@rbxts": { "$path": "node_modules/@rbxts" }, "@flamework": { "$path": "node_modules/@flamework" } }
            }
        },
        "ServerScriptService": { "Server": { "$path": "out/server" } }
    }
}
